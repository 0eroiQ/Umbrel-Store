#!/usr/bin/env bash
set -euo pipefail

APP_DIR="$(readlink -f "$(dirname "${BASH_SOURCE[0]}")/..")"
APP_DATA_DIR="${APP_DIR}/data"
# MOUNT_DIR must be under home/Downloads/ because that's the path the stock
# Umbrel Plex app bind-mounts into its container at /downloads. Only paths
# under home/Downloads/riven/ will be visible to Plex as /downloads/riven/.
MOUNT_DIR="${UMBREL_ROOT}/home/Downloads/riven"
LEGACY_MOUNT_DIR="${UMBREL_ROOT}/data/storage/downloads/riven"
RIVEN_DATA_DIR="${APP_DATA_DIR}/riven"
FRONTEND_DATA_DIR="${APP_DATA_DIR}/frontend"
POSTGRES_DATA_DIR="${APP_DATA_DIR}/postgres"

raise_inotify_limits() {
  if command -v sysctl >/dev/null 2>&1; then
    sysctl -w fs.inotify.max_user_watches=1048576 >/dev/null 2>&1 || true
    sysctl -w fs.inotify.max_user_instances=2048 >/dev/null 2>&1 || true
    sysctl -w fs.inotify.max_queued_events=32768 >/dev/null 2>&1 || true
  fi
}

cleanup_stale_mount() {
  local path="$1"

  if findmnt -T "${path}" >/dev/null 2>&1 && ! ls -A "${path}" >/dev/null 2>&1; then
    echo "Recovering stale Riven mount at ${path}"
    umount -l "${path}" 2>/dev/null || true
  fi
}

force_cleanup_fuse_mount() {
  # Remove ANY fuse/rivenvfs mount on the given path, even if it appears readable.
  # A stale FUSE mount whose backing process died returns "Transport endpoint is
  # not connected", but one whose backing process was replaced by a newer Riven
  # instance can appear readable yet serve stale/empty data. We unconditionally
  # tear down fuse mounts here so the current Riven container's VFS is the only
  # one authoritative.
  local path="$1"

  if findmnt -T "${path}" -o FSTYPE -n 2>/dev/null | grep -qiE "fuse"; then
    echo "Removing stale FUSE mount at ${path}"
    umount -l "${path}" 2>/dev/null || true
  fi
}

raise_inotify_limits

# The legacy path (data/storage/downloads/riven) was used by v0.23.6-28..34 but
# is NOT under the stock Umbrel Plex app's /downloads mount, so Plex could never
# see Riven's content. Clean up any stale FUSE mount there and switch to
# home/Downloads/riven which Plex mounts as /downloads/riven.
force_cleanup_fuse_mount "${LEGACY_MOUNT_DIR}"

cleanup_stale_mount "${LEGACY_MOUNT_DIR}"
mkdir -p "$(dirname "${MOUNT_DIR}")"
cleanup_stale_mount "${MOUNT_DIR}"

mkdir -p "${MOUNT_DIR}" "${RIVEN_DATA_DIR}" "${FRONTEND_DATA_DIR}" "${POSTGRES_DATA_DIR}"
mkdir -p "${RIVEN_DATA_DIR}/logs"

if ! mountpoint -q "${MOUNT_DIR}"; then
  mount --bind "${MOUNT_DIR}" "${MOUNT_DIR}"
fi

PROPAGATION="$(findmnt -T "${MOUNT_DIR}" -o PROPAGATION -n 2>/dev/null || true)"
if [[ "${PROPAGATION}" != "shared" && "${PROPAGATION}" != "rshared" ]]; then
  mount --make-rshared "${MOUNT_DIR}"
fi

chown -R 1000:1000 "${RIVEN_DATA_DIR}" "${FRONTEND_DATA_DIR}" "${MOUNT_DIR}"

if [[ ! -e /dev/fuse ]]; then
  echo "Warning: /dev/fuse is not available on this Umbrel host. Riven will not be able to mount its library." >&2
fi
